[Unit]
Description=Knight Medical Billing Next.js server
After=network.target

[Service]
Type=simple
User=knight
Group=knight
WorkingDirectory=/srv/knight/current
EnvironmentFile=/etc/knight/knight.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
