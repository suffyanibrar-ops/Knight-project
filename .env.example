# ===========================================================================
# Knight Medical Billing — environment configuration
# Copy to `.env` locally; paste into your host's dashboard in production.
# `.env` is git-ignored and never shipped in the project archive.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. ADMIN CONSOLE SECURITY — required in production
# ---------------------------------------------------------------------------
# Password for /admin and /admin/inbox. Admin sign-in is DISABLED in EVERY
# environment (fail closed) unless a password is configured here, via
# ADMIN_PASSWORD_HASH, or from the admin panel (which requires signing in
# first). There is no default password.
# Minimum 12 characters recommended.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Optional legacy alternative to ADMIN_PASSWORD: the hex SHA-256 digest of
# (ADMIN_SESSION_SECRET + password). Only used when no password was changed
# from the admin panel and ADMIN_PASSWORD is unset; it requires the exact
# ADMIN_SESSION_SECRET value used to derive it. Prefer ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Signs the admin session cookie (HMAC). Should be long, random and identical
# on every instance. If unset in production, a random per-process key is
# generated instead: cookies cannot be forged, but sessions reset on restart
# and are not shared between instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-hex-characters

# Where owner notification emails are sent (informational + email templates).
ADMIN_EMAIL=thomas@knightmedicalbilling.com

# ---------------------------------------------------------------------------
# 2. REQUIRED FOR CORRECT SEO — public site URL
# ---------------------------------------------------------------------------
# Used for canonical tags, sitemap.xml, robots.txt, Open Graph and email links.
# No trailing slash. Must be https:// in production.
NEXT_PUBLIC_SITE_URL=https://www.knightmedicalbilling.com

# ---------------------------------------------------------------------------
# 3. SQLITE — THE ONLY STORE (REQUIRED)
# ---------------------------------------------------------------------------
# One local file, created automatically on first run; its tables are created and
# upgraded at startup (PRAGMA user_version migrations). There is no external
# database and no connection string.
#
# The directory must be WRITABLE by the app process and PERSIST across restarts
# and redeploys. Use an absolute path on a mounted persistent volume, e.g.
# /var/data/app.db. Relative paths resolve from the project root; the default is
# ./data/app.db.
#
# Never point SQLITE_PATH at /tmp, at a public/static directory, or inside the
# deployment bundle: those are wiped on deploy, replaced on release, and/or
# publicly served. Losing this file loses every submission and admin record.
# Back it up (see DEPLOYMENT.md §4 — WAL mode uses -wal/-shm companions).
SQLITE_PATH=./data/app.db

# ---------------------------------------------------------------------------
# 4. SERVER-SIDE EMAIL — Resend (owner notifications + visitor confirmations)
# ---------------------------------------------------------------------------
# Both emails are sent from a Next.js route handler (POST /api/submissions).
# No email credential is ever shipped to the browser or called from frontend
# code.
#
# Resend (recommended):
#   1. Create a key at https://resend.com/api-keys
#   2. Verify the sender domain at https://resend.com/domains
#   3. Set MAIL_FROM to an address on a domain VERIFIED FOR THAT KEY. Resend
#      rejects the send with "not authorized to send emails from <domain>"
#      when the key cannot use the domain.
RESEND_API_KEY=
MAIL_FROM="Knight Medical Billing <website@knightmedicalbilling.com>"

# ADMIN_EMAIL above is also the Reply-To on visitor confirmations, so replies
# reach a monitored mailbox instead of the sending address.

# Resend webhook signing secret (starts with whsec_…). Create the endpoint in
# the Resend dashboard at https://<your-domain>/api/webhooks/resend and
# subscribe to email.delivered, email.bounced, email.complained,
# email.delivery_delayed and email.failed. Delivery events then update the
# SQLite outbox row. Without this value the endpoint refuses requests; sending
# emails still works.
# RESEND_WEBHOOK_SECRET=

# Optional SMTP fallback, tried when Resend is unset or a Resend delivery fails:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Legacy owner-only relay (no longer needed when Resend is configured; never
# used for visitor confirmations):
# ENABLE_FORM_SUBMIT_RELAY=0
# Set to 1 to disable the legacy relay even when it is enabled above:
# DISABLE_FORM_SUBMIT=0

# ---------------------------------------------------------------------------
# 5. IMAGES — optional
# ---------------------------------------------------------------------------
# Set to 1 only if your host cannot run the sharp image optimiser.
# IMAGES_UNOPTIMIZED=0

# ---------------------------------------------------------------------------
# 6. PROXY TRUST — rate limiting and audit IPs
# ---------------------------------------------------------------------------
# Default 1 assumes exactly one trusted reverse proxy in front of the app
# (HostNext, Vercel, Cloudflare, nginx, a load balancer). The LAST
# X-Forwarded-For hop is used, because that is the entry the proxy itself appends
# and the client cannot forge. If several proxy layers are chained, terminate at
# one trusted layer.
# Set to 0 only when the app is directly exposed to the internet: X-Forwarded-For
# is then ignored and all callers share one rate-limit bucket, so add an upstream
# limiter in that mode.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# NOTE ON EMAIL CREDENTIALS
# ---------------------------------------------------------------------------
# RESEND_API_KEY (and SMTP_PASS) are SERVER-ONLY secrets. Never move them into a
# NEXT_PUBLIC_* variable and never import them from a client component. The
# browser posts forms to the app's own API routes; those routes send the owner
# notification and the visitor confirmation, and the browser never talks to
# Resend.

# Optional Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to ship no analytics script.
NEXT_PUBLIC_GA_ID=
